{
  "name": "@lumen/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:load": "k6 run __tests__/load/main.js",
    "test:load:cosign": "k6 run __tests__/load/cosign.js",
    "test:load:fee-bump": "k6 run __tests__/load/fee-bump.js",
    "test:load:health": "k6 run __tests__/load/health.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1133.0",
    "@lumen/core": "workspace:*",
    "@lumen/types": "workspace:*",
    "@prisma/client": "^6.2.1",
    "@stellar/stellar-sdk": "^17.0.1",
    "bullmq": "^5.34.0",
    "cors": "2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.24.6",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pino-http": "^5.8.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^3.23.1",
    "prisma": "^6.2.1",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "k6": {
    "description": "High-throughput load and concurrency benchmark suite for @lumen/server. Requires the k6 CLI (https://k6.io/docs/get-started/installation/) to be installed and available on PATH.",
    "scripts": {
      "test:load": "Runs the full benchmark suite (cosign, fee-bump, health) via __tests__/load/main.js.",
      "test:load:cosign": "Runs the /cosign load scenario via __tests__/load/cosign.js.",
      "test:load:fee-bump": "Runs the /fee-bump load scenario via __tests__/load/fee-bump.js.",
      "test:load:health": "Runs the /health load scenario via __tests__/load/health.js."
    },
    "environmentVariables": {
      "BASE_URL": {
        "description": "Base URL of the running @lumen/server instance under test.",
        "default": "http://localhost:3000",
        "example": "BASE_URL=https://staging.lumen.example.com"
      },
      "VUS": {
        "description": "Number of concurrent virtual users (VUs) to run during the benchmark.",
        "default": "250",
        "example": "VUS=500"
      },
      "DURATION": {
        "description": "Sustained duration of the load test (k6 duration string, e.g. 30s, 1m, 5m).",
        "default": "1m",
        "example": "DURATION=5m"
      },
      "RPS": {
        "description": "Target requests per second for the constant-arrival-rate executor.",
        "default": "250",
        "example": "RPS=500"
      },
      "P95_THRESHOLD_MS": {
        "description": "Acceptance-criteria threshold for the p95 response time in milliseconds; the test fails if exceeded.",
        "default": "150",
        "example": "P95_THRESHOLD_MS=150"
      }
    },
    "acceptanceCriteria": "Server maintains < 150ms p95 response time at 250 requests/second on standard compute hardware. Latency percentiles (p50, p95, p99) and throughput are reported by k6 at the end of each run."
  }
}