{
  "title": "Lumen SLO",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Sponsor balance (XLM)",
      "type": "timeseries",
      "targets": [{ "expr": "lumen_sponsor_balance_xlm", "legendFormat": "XLM" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Co-sign error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(lumen_cosign_requests_total{status=\"rejected\"}[5m])) / clamp_min(sum(rate(lumen_cosign_requests_total[5m])), 1e-9)",
          "legendFormat": "Error rate"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Policy evaluation p95 (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lumen_policy_evaluation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Stellar endpoint latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "lumen_stellar_endpoint_latency_ms",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
